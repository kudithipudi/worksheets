# ── OpenRouter ────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── LLM Model ─────────────────────────────────────────────────────────────────
# Confirmed model slug from openrouter.ai/models
LLM_MODEL=qwen/qwen3-vl-30b-a3b-thinking

# ── Application ───────────────────────────────────────────────────────────────
SITE_URL=https://yourdomain.com
DATABASE_URL=sqlite:///./data/worksheets.db

# ── Hybrid-sourcing threshold: use DB when ≥ N vetted questions exist ─────────
VETTED_THRESHOLD=1000

# ── Subpath deployment (behind nginx at /<app>/) ──────────────────────────────
ROOT_PATH=/worksheets
