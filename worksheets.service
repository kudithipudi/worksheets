[Unit]
Description=Texas Worksheet Generator (FastAPI + Gunicorn)
After=network.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=all

User=www-data
Group=www-data
WorkingDirectory=/var/www/worksheets

# Load secrets / config from .env
EnvironmentFile=/var/www/worksheets/.env

# Use the virtualenv gunicorn
ExecStart=/var/www/worksheets/venv/bin/gunicorn \
    --config /var/www/worksheets/gunicorn_config.py \
    main:app

ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=30

# Restart policy
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=3

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/www/worksheets /tmp

[Install]
WantedBy=multi-user.target
